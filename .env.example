# Optional. The default is primer_db/fhi_primers.unified.json relative to the repository.
# PRIMER_DATABASE_PATH=/absolute/path/to/custom/database.json
# Optional. Resolution is BLASTN_PATH, bundled bin/blastn, then PATH.
# BLASTN_PATH=/absolute/path/to/blastn
# Optional local provenance; Vercel supplies VERCEL_GIT_COMMIT_SHA automatically.
# APP_GIT_COMMIT=<full-git-commit>
# scripts/dev.mjs automatically finds .venv/bin/python; override if necessary.
# PYTHON=/absolute/path/to/python3
